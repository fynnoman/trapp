# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absenderadresse der Projektanfragen.
#
# WICHTIG für die Zustellbarkeit:
#   1. Die Domain MUSS auf https://resend.com/domains verifiziert sein
#      (SPF-, DKIM- und idealerweise DMARC-DNS-Einträge gesetzt).
#   2. "onboarding@resend.dev" NICHT verwenden - web.de, GMX, Gmail und
#      viele andere filtern diesen Shared-Sender fast immer in den Spam.
#   3. Lokaler Teil frei wählbar, z.B. "kontakt", "info", "noreply".
#
# Format: "Anzeigename <adresse@verifizierte-domain.de>"
CONTACT_FROM_EMAIL=GDH Christoph Trapp <kontakt@gipser-der-herzen.de>

# Zieladresse(n), an die Projektanfragen zugestellt werden.
# Mehrere Empfänger per Komma trennen.
CONTACT_TO_EMAIL=info@gipser-der-herzen.de
